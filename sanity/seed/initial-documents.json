  {
    "_id": "page.about-our-story",
    "_type": "page",
    "title": "Our Story",
    "section": "about",
    "slug": {"_type": "slug", "current": "our-story"},
    "excerpt": "Northland Basketball exists to grow the game across every part of the region.",
    "body": [
      {
        "_key": "about-block-1",
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_key": "about-span-1",
            "_type": "span",
            "text": "Northland Basketball connects clubs, schools, players, coaches, referees, and communities across the region. Our role is to create strong local opportunities while building pathways into regional and national basketball."
          }
        ]
      },
      {
        "_key": "about-block-2",
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_key": "about-span-2",
            "_type": "span",
            "text": "We are committed to making the game accessible, inclusive, and sustainable across Northland, from grassroots programmes through to representative development."
          }
        ]
      }
    ]
  },
