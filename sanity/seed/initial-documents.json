    "programmesHeading": "Play Basketball at Every Level",
    "programmesBody": [
      {
        "_key": "home-body-1",
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_key": "home-body-1-span",
            "_type": "span",
            "text": "Northland Basketball is built by and for our people. Stretching from Te Hana in the south to Cape Reinga in the north, our clubs, programmes, and competitions are powered by volunteers, whanau, coaches, and players who care deeply about creating opportunities close to home."
          }
        ]
      },
      {
        "_key": "home-body-2",
        "_type": "block",
        "style": "normal",
        "markDefs": [],
        "children": [
          {
            "_key": "home-body-2-span",
            "_type": "span",
            "text": "We believe basketball should be accessible, welcoming, and connected to the communities it represents. From first steps on the court to representative pathways, we are working to lift every level of the game across the region."
          }
        ]
      }
    ],
    "programmeCards": [
      {"_key": "programme-kiwihoops", "title": "KiwiHoops (Youth)", "href": "/programmes/kiwi-hoops", "featured": true},
